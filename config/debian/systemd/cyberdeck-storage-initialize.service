[Unit]
Description=Cyberdeck explicit disk initialization
After=local-fs.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/lib/cyberdeck/storage-helper.py initialize-worker
TimeoutStartSec=infinity
# Mount operations must remain visible in the host namespace.
ProtectSystem=off
ProtectHome=false
NoNewPrivileges=false
