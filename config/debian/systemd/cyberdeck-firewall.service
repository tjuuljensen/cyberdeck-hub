[Unit]
Description=Cyberdeck managed nftables firewall
After=network-pre.target
Before=network.target
ConditionPathExists=/etc/cyberdeck/firewall-enabled

[Service]
Type=oneshot
ExecStart=/usr/local/lib/cyberdeck/admin-helper.py firewall-load
ExecStop=/usr/local/lib/cyberdeck/admin-helper.py firewall-remove
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
