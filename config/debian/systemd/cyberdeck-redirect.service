[Unit]
Description=Cyberdeck certificate bootstrap and HTTP to HTTPS redirect
After=network.target

[Service]
User=cyberdeck
Group=cyberdeck
EnvironmentFile=/etc/cyberdeck/environment
ExecStart=/usr/bin/python3 /usr/local/lib/cyberdeck/http-redirect.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
