[Unit]
Description=Cyberdeck CyberChef static web application
After=network.target cyberdeck-web.service
Wants=cyberdeck-web.service

[Service]
User=cyberdeck
Group=cyberdeck
SupplementaryGroups=cyberdeck-tls
EnvironmentFile=/etc/cyberdeck/environment
Environment=CYBERDECK_CYBERCHEF_PORT=8445
ExecStart=/usr/bin/python3 /usr/local/lib/cyberdeck/app/cyberchef_server.py --root /opt/cyberdeck/modules/cyberchef --cert /etc/cyberdeck/tls/server.crt --key /etc/cyberdeck/tls/server.key --host 0.0.0.0 --port 8445
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/cyberdeck/modules/cyberchef /etc/cyberdeck/tls
UMask=0077

[Install]
WantedBy=multi-user.target
